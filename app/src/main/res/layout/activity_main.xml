<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/camera_preview" />

    <com.pushupbird.ui.GameView
        android:id="@+id/game"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/playfield" />

    <FrameLayout
        android:id="@+id/chrome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true">

        <FrameLayout
            android:id="@+id/ready_group"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_margin="16dp"
                android:background="@drawable/bg_card"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="18dp">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_accent" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.12"
                    android:text="@string/ready_kicker"
                    android:textAllCaps="true"
                    android:textColor="@color/brass"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/ready_title"
                    android:textColor="@color/cream"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/ready_body"
                    android:textColor="@color/cream_dim"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/travel_label"
                    android:textColor="@color/cream"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/travel_toggle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/travel_small"
                        style="@style/Widget.PushupBird.Travel"
                        android:text="@string/travel_small" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/travel_medium"
                        style="@style/Widget.PushupBird.Travel"
                        android:text="@string/travel_medium" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/travel_large"
                        style="@style/Widget.PushupBird.Travel"
                        android:text="@string/travel_large" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/travel_hint"
                    android:textColor="@color/cream_dim"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/ready_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/looking_for_face"
                    android:textColor="@color/brass"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/start_button"
                    style="@style/Widget.PushupBird.Primary"
                    android:text="@string/start" />

                <TextView
                    android:id="@+id/best_ready"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center"
                    android:text="@string/best_none"
                    android:textColor="@color/cream"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="@string/privacy_foot"
                    android:textColor="@color/cream_dim"
                    android:textSize="12sp" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_height_button"
            style="@style/Widget.PushupBird.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="4dp"
            android:text="@string/reset_height"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/paused_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/paused_title"
                android:textColor="@color/cream"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pause_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/pause_reset"
                android:textColor="@color/cream_dim"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resume_button"
                style="@style/Widget.PushupBird.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/resume" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/recalibrate_button"
                style="@style/Widget.PushupBird.Secondary"
                android:layout_marginTop="8dp"
                android:text="@string/set_again" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/game_over_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="16dp"
            android:background="@drawable/bg_card"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:background="@drawable/bg_accent" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/game_over_title"
                android:textColor="@color/cream"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/score_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/cream"
                android:textSize="56sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/new_best"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/new_best"
                android:textColor="@color/brass"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/best_over"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cream_dim"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/game_over_body"
                android:textColor="@color/cream_dim"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/travel_label"
                android:textColor="@color/cream"
                android:textSize="13sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/over_travel_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/over_travel_small"
                    style="@style/Widget.PushupBird.Travel"
                    android:text="@string/travel_small" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/over_travel_medium"
                    style="@style/Widget.PushupBird.Travel"
                    android:text="@string/travel_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/over_travel_large"
                    style="@style/Widget.PushupBird.Travel"
                    android:text="@string/travel_large" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/retry_button"
                style="@style/Widget.PushupBird.Primary"
                android:layout_marginTop="16dp"
                android:text="@string/retry" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/permission_screen"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/ink"
            android:clickable="true"
            android:fillViewport="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="48dp"
                android:paddingEnd="28dp"
                android:paddingBottom="32dp">

                <ImageView
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_launcher_fg" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.14"
                    android:text="@string/wordmark"
                    android:textColor="@color/brass"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/permission_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_title"
                    android:textColor="@color/cream"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/permission_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/permission_body"
                    android:textColor="@color/cream_dim"
                    android:textSize="16sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enable_camera_button"
                    style="@style/Widget.PushupBird.Primary"
                    android:layout_marginTop="28dp"
                    android:text="@string/permission_enable" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_settings_button"
                    style="@style/Widget.PushupBird.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/permission_settings"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</FrameLayout>
